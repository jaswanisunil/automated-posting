# DEV/Forem API key generated from https://dev.to/settings/extensions
DEV_API_KEY=
DEV_PLATFORM_TIMEOUT_SECONDS=10

# Mastodon instance and user access token with the write:statuses scope
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
MASTODON_PLATFORM_TIMEOUT_SECONDS=10

# Telegram bot token from @BotFather and numeric chat/channel ID or @username
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PLATFORM_TIMEOUT_SECONDS=10

# Incoming Discord webhook URL (treat the URL as a secret)
DISCORD_WEBHOOK_URL=
DISCORD_PLATFORM_TIMEOUT_SECONDS=10

# Bluesky handle/DID, app password (not account password), and PDS base URL
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_PLATFORM_TIMEOUT_SECONDS=10
